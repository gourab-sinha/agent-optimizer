# =============================================================================
# Voice AI Agent Optimizer – Backend Environment
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*
LOG_FORMAT=dev
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: serve the built Vue client from Express (production)
# FRONTEND_BUILD_PATH=../client/dist

# -----------------------------------------------------------------------------
# Database (PostgreSQL) – REQUIRED
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_optimizer
DB_POOL_MIN=2
DB_POOL_MAX=10

# -----------------------------------------------------------------------------
# Token encryption – REQUIRED
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes).
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# HighLevel OAuth / Marketplace App – REQUIRED for install + API access
# Create the app at: https://marketplace.gohighlevel.com/
# Developer Portal → Create App → Auth settings
# -----------------------------------------------------------------------------
GHL_CLIENT_ID=your_application_client_id
GHL_CLIENT_SECRET=your_application_client_secret

# Must match EXACTLY a Redirect URL registered on the marketplace app.
# Local (with ngrok or similar): https://YOUR_SUBDOMAIN.ngrok-free.app/api/oauth/callback
# Production: https://your-domain.com/api/oauth/callback
GHL_REDIRECT_URI=https://YOUR_PUBLIC_URL/api/oauth/callback

# Comma-separated scopes (no spaces around commas preferred)
GHL_SCOPES=voice-ai-agents.readonly,voice-ai-agents.write,voice-ai-dashboard.readonly,voice-ai-agent-goals.readonly,voice-ai-agent-goals.write

# SSO Shared Secret – Developer Portal → your app → Manage → SSO Key
# Used to decrypt iframe postMessage user data when the app runs inside GHL
GHL_SHARED_SECRET=your_sso_shared_secret

# API endpoints (defaults are fine for most installs)
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_OAUTH_BASE=https://marketplace.gohighlevel.com/oauth
GHL_TOKEN_URL=https://services.leadconnectorhq.com/oauth/token
GHL_VERSION_HEADER=2021-07-28

# -----------------------------------------------------------------------------
# LLM – REQUIRED for rubric generation, evaluation, patterns, tests, recs
# Provider: anthropic | openai
# -----------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# Anthropic (when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI (when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
