# Database Configuration
DATABASE_URL=YOUR_DATABASE_URL
DB_POOL_MIN=2
DB_POOL_MAX=10

# HighLevel OAuth Configuration
GHL_OAUTH_BASE=https://marketplace.gohighlevel.com/oauth
GHL_TOKEN_URL=https://services.leadconnectorhq.com/oauth/token
GHL_CLIENT_ID=your_application_client_id
GHL_CLIENT_SECRET=your_application_client_secret
GHL_REDIRECT_URI=your_domain/api/oauth/callback
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_VERSION_HEADER=v3

# OAuth Scopes (comma-separated)
GHL_SCOPES=your_application_scope

# SSO Shared Secret (from HighLevel Developer Portal > Manage > SSO Key)
GHL_SHARED_SECRET=sso_shared_secret

# LLM Configuration
# Provider: openai or anthropic
LLM_PROVIDER=anthropic

# OpenAI Configuration (if using LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Anthropic Configuration (if using LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022